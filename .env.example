# The API's origin, baked in at build time.
#
# Empty is the original deployment and still the default: the API mounts this
# build at `/`, so the surface and the API share an origin and there is nothing
# to configure (SPEC-0000 §7). Hosting the surface separately — on Cloudflare
# Pages, say — reverses that (ADR-0020), and this is how the surface is told.
#
# Set it and the client sends credentials cross-origin; the API must name this
# surface's origin in ALLOWED_ORIGINS or the browser will refuse every call.
#
#   VITE_API_URL=https://cortex-api.onrender.com
VITE_API_URL=

# Gatehouse, which holds identity (ADR-0026). The default is the deployed one.
#
# The tenant slug is sent as X-App-Slug on every call and is what the API's
# tokens are minted for; outside development there is no default and a request
# naming no tenant is refused with 400 before authentication is considered.
VITE_AUTH_URL=
VITE_APP_SLUG=

# NOTE on where this surface may be served. Gatehouse's refresh cookie is
# SameSite=Lax, so the auth host must be same-site with this origin.
# interview-lm.buildspacelabs.com works; a *.pages.dev host cannot, because
# pages.dev is a public suffix and no auth host can be same-site with it. The
# failure is silent: sign-in appears to work and the member is signed out by
# their next reload, on Safari and not Chrome.
